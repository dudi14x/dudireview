# Copy this file to .env.local. Keep the real key private; never commit .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Local cap counts attempted requests, including errors; cache hits do not count.
GEMINI_DAILY_REQUEST_LIMIT=5

# Optional: activate your locally trained semantic network, then restart.
# FLOORREVIEW_MODEL=models/reviewed-plan-unet.pt
